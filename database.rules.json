{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('meta/participants').child(auth.uid).exists()",
        ".write": "auth != null && ((data.exists() && data.child('meta/participants').child(auth.uid).exists()) || (!data.exists() && newData.child('meta/participants').child(auth.uid).exists()))",
        "meta": {
          "participants": {
            "$participantUid": {
              ".validate": "newData.isBoolean() && newData.val() === true"
            }
          },
          "lastMessage": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "lastMessageType": {
            ".validate": "newData.val() === 'text' || newData.val() === 'location'"
          },
          "lastMessageAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'type', 'text', 'createdAt'])",
            "senderId": {
              ".validate": "newData.val() === auth.uid"
            },
            "type": {
              ".validate": "newData.val() === 'text' || newData.val() === 'location'"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "latitude": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "longitude": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('meta/participants').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['chatId', 'otherUid', 'lastMessage', 'lastMessageType', 'lastMessageAt', 'unreadCount'])",
          "chatId": {
            ".validate": "newData.val() === $chatId"
          },
          "otherUid": {
            ".validate": "newData.isString()"
          },
          "lastMessage": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "lastMessageType": {
            ".validate": "newData.val() === 'text' || newData.val() === 'location'"
          },
          "lastMessageAt": {
            ".validate": "newData.isNumber()"
          },
          "unreadCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
